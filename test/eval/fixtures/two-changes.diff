+--- Forget one answer.
+---
+--- Used when an answer turns out to be unusable: leaving it on disk would mean
+--- replaying a known-bad result on every open until someone refreshes by hand.
+---@param repo revstack.Repo
+---@param key string
+---@param cb fun()?
+function M.forget(repo, key, cb)
+  cb = cb or function() end
+  vim.uv.fs_unlink(
+    path_for(repo, key),
+    vim.schedule_wrap(function()
+      cb()
+    end)
+  )
+end
+
 --- Drop the oldest entries once the cache grows past its cap. Called once when
 --- a review opens rather than on every write.
 ---@param repo revstack.Repo
