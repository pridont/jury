@@ -9,6 +9,7 @@ local M = {}
 ---@field header integer window handle, spanning both diff sides
 ---@field old integer window handle, the base side
 ---@field new integer window handle, the changed side
+---@field single boolean whether the base side is collapsed for want of anything to compare
 ---@field diffopt string the user's diffopt, restored on close
 
 ---@param win integer
@@ -48,6 +49,59 @@ local function apply_diffopt()
   return original
 end
 
+--- Options both diff sides carry.
+---
+--- Folds start closed so unchanged regions collapse into a band rather than
+--- making the reviewer scroll through a whole file to find the change.
+---@type table<string, any>
+M.diff_win_options = {
+  wrap = false,
+  cursorbind = true,
+  foldlevel = 0,
+  foldcolumn = "0",
+  foldtext = "v:lua.require'revstack.ui.fold'.text()",
+  fillchars = "fold: ,diff: ",
+}
+
+--- Collapse the base side.
+---
+--- A file that was just added has nothing on the left: two panes, one of them
+--- blank, with every line on the right painted as an addition, says nothing
+--- that one pane does not. Reading a new file is just reading a file.
+---@param layout revstack.Layout
+function M.collapse(layout)
+  if layout.single then
+    return
+  end
+  if vim.api.nvim_win_is_valid(layout.old) then
+    pcall(vim.api.nvim_win_close, layout.old, true)
+  end
+  -- An invalid handle rather than nil, so every existing validity check keeps
+  -- working without a nil branch of its own.
+  layout.old = -1
+  layout.single = true
+end
+
+--- Bring the base side back.
+---@param layout revstack.Layout
+function M.expand(layout)
+  if not layout.single then
+    return
+  end
+  if not vim.api.nvim_win_is_valid(layout.new) then
+    return
+  end
+
+  local win = vim.api.nvim_open_win(placeholder(), false, { split = "left", win = layout.new })
+  set_win_options(win, M.diff_win_options)
+  layout.old = win
+  layout.single = false
+
+  vim.api.nvim_win_call(win, function()
+    vim.cmd("wincmd =")
+  end)
+end
+
