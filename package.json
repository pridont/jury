{
  "name": "change-stack",
  "displayName": "Change Stack",
  "description": "Review a diff as an ordered stack of logical changes instead of an alphabetical list of files. AI organises and summarises; you judge.",
  "version": "0.0.1",
  "publisher": "pridont",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pridont/change-stack-vscode.git"
  },
  "homepage": "https://github.com/pridont/change-stack-vscode#readme",
  "bugs": {
    "url": "https://github.com/pridont/change-stack-vscode/issues"
  },
  "private": true,
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "code review",
    "diff",
    "pull request",
    "claude",
    "ai"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:changestack.stack"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "changestack",
          "title": "Change Stack",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "changestack": [
        {
          "id": "changestack.stack",
          "name": "Change Stack"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "changestack.stack",
        "contents": "No review is open.\n[Review working tree](command:changestack.review)\n[Review staged changes](command:changestack.reviewStaged)\n[Review this branch](command:changestack.reviewBase)\n[Review a pull request](command:changestack.reviewPr)\n[Resume last review](command:changestack.resume)\n",
        "when": "!changestack.active"
      }
    ],
    "commands": [
      {
        "command": "changestack.review",
        "title": "Review Working Tree",
        "category": "Change Stack",
        "icon": "$(git-compare)"
      },
      {
        "command": "changestack.reviewStaged",
        "title": "Review Staged Changes",
        "category": "Change Stack"
      },
      {
        "command": "changestack.reviewBase",
        "title": "Review This Branch\u2026",
        "category": "Change Stack"
      },
      {
        "command": "changestack.reviewPr",
        "title": "Review a Pull Request\u2026",
        "category": "Change Stack"
      },
      {
        "command": "changestack.submitReview",
        "title": "Submit Review to GitHub\u2026",
        "category": "Change Stack",
        "icon": "$(github)"
      },
      {
        "command": "changestack.refresh",
        "title": "Refresh Review",
        "category": "Change Stack",
        "icon": "$(refresh)"
      },
      {
        "command": "changestack.close",
        "title": "Close Review",
        "category": "Change Stack",
        "icon": "$(close)"
      },
      {
        "command": "changestack.resume",
        "title": "Resume Last Review",
        "category": "Change Stack"
      },
      {
        "command": "changestack.list",
        "title": "Open a Saved Review\u2026",
        "category": "Change Stack"
      },
      {
        "command": "changestack.doctor",
        "title": "Doctor",
        "category": "Change Stack"
      },
      {
        "command": "changestack.nextHunk",
        "title": "Next Hunk",
        "category": "Change Stack"
      },
      {
        "command": "changestack.prevHunk",
        "title": "Previous Hunk",
        "category": "Change Stack"
      },
      {
        "command": "changestack.nextLayer",
        "title": "Next Layer",
        "category": "Change Stack"
      },
      {
        "command": "changestack.prevLayer",
        "title": "Previous Layer",
        "category": "Change Stack"
      },
      {
        "command": "changestack.openLayer",
        "title": "Open Layer",
        "category": "Change Stack"
      },
      {
        "command": "changestack.openCohort",
        "title": "Open All Files in This Cohort",
        "category": "Change Stack",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "changestack.toggleReviewed",
        "title": "Toggle Reviewed on This Hunk",
        "category": "Change Stack"
      },
      {
        "command": "changestack.markLayerReviewed",
        "title": "Mark Layer Reviewed and Advance",
        "category": "Change Stack"
      },
      {
        "command": "changestack.markCohortReviewed",
        "title": "Mark Cohort Reviewed",
        "category": "Change Stack",
        "icon": "$(check-all)"
      },
      {
        "command": "changestack.notScaffolding",
        "title": "Not Scaffolding",
        "category": "Change Stack",
        "icon": "$(eye)"
      },
      {
        "command": "changestack.focusMode",
        "title": "Focus Mode",
        "category": "Change Stack"
      },
      {
        "command": "changestack.createComment",
        "title": "Add Note",
        "category": "Change Stack"
      },
      {
        "command": "changestack.editComment",
        "title": "Edit",
        "category": "Change Stack",
        "icon": "$(edit)"
      },
      {
        "command": "changestack.saveComment",
        "title": "Save",
        "category": "Change Stack"
      },
      {
        "command": "changestack.cancelComment",
        "title": "Cancel",
        "category": "Change Stack"
      },
      {
        "command": "changestack.deleteComment",
        "title": "Delete",
        "category": "Change Stack",
        "icon": "$(trash)"
      },
      {
        "command": "changestack.repinComment",
        "title": "Re-pin to a Hunk\u2026",
        "category": "Change Stack",
        "icon": "$(pin)"
      },
      {
        "command": "changestack.discardComment",
        "title": "Discard",
        "category": "Change Stack",
        "icon": "$(trash)"
      },
      {
        "command": "changestack.export",
        "title": "Export Review as Markdown",
        "category": "Change Stack",
        "icon": "$(markdown)"
      },
      {
        "command": "changestack.clearCache",
        "title": "Clear Model Answer Cache",
        "category": "Change Stack"
      },
      {
        "command": "changestack.showLog",
        "title": "Show Log",
        "category": "Change Stack",
        "icon": "$(output)"
      },
      {
        "command": "changestack.walkthrough",
        "title": "Show Walkthrough",
        "category": "Change Stack",
        "icon": "$(book)"
      },
      {
        "command": "changestack.recluster",
        "title": "Reorganise the Stack",
        "category": "Change Stack",
        "icon": "$(sparkle)"
      },
      {
        "command": "changestack.openLayerFile",
        "title": "Open File",
        "category": "Change Stack"
      },
      {
        "command": "changestack.openLayerFiles",
        "title": "Open All Files in This Step",
        "category": "Change Stack",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "changestack.ask",
        "title": "Ask About This Hunk",
        "category": "Change Stack",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "changestack.askStep",
        "title": "Ask About This Step",
        "category": "Change Stack"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "changestack.walkthrough",
          "when": "view == changestack.stack && changestack.active",
          "group": "navigation@0"
        },
        {
          "command": "changestack.export",
          "when": "view == changestack.stack && changestack.active",
          "group": "navigation@0"
        },
        {
          "command": "changestack.refresh",
          "when": "view == changestack.stack && changestack.active",
          "group": "navigation@1"
        },
        {
          "command": "changestack.close",
          "when": "view == changestack.stack && changestack.active",
          "group": "navigation@2"
        },
        {
          "command": "changestack.showLog",
          "when": "view == changestack.stack",
          "group": "1_log@1"
        },
        {
          "command": "changestack.recluster",
          "when": "view == changestack.stack && changestack.active",
          "group": "1_log@0"
        },
        {
          "command": "changestack.submitReview",
          "when": "view == changestack.stack && changestack.pr",
          "group": "1_log@2"
        }
      ],
      "view/item/context": [
        {
          "command": "changestack.openCohort",
          "when": "view == changestack.stack && viewItem =~ /^cohort/",
          "group": "inline@1"
        },
        {
          "command": "changestack.openCohort",
          "when": "view == changestack.stack && viewItem =~ /^cohort/",
          "group": "navigation@1"
        },
        {
          "command": "changestack.markCohortReviewed",
          "when": "view == changestack.stack && viewItem =~ /^cohort/",
          "group": "navigation@2"
        },
        {
          "command": "changestack.notScaffolding",
          "when": "view == changestack.stack && viewItem == cohort-scaffolding",
          "group": "navigation@3"
        },
        {
          "command": "changestack.notScaffolding",
          "when": "view == changestack.stack && viewItem == layer",
          "group": "navigation@3"
        },
        {
          "command": "changestack.openLayer",
          "when": "view == changestack.stack && viewItem == layer",
          "group": "navigation@1"
        },
        {
          "command": "changestack.repinComment",
          "when": "view == changestack.stack && viewItem == orphan",
          "group": "inline@1"
        },
        {
          "command": "changestack.discardComment",
          "when": "view == changestack.stack && viewItem == orphan",
          "group": "inline@2"
        },
        {
          "command": "changestack.openLayerFiles",
          "when": "view == changestack.stack && viewItem == layer",
          "group": "inline@1"
        },
        {
          "command": "changestack.openLayerFiles",
          "when": "view == changestack.stack && viewItem == layer",
          "group": "navigation@0"
        }
      ],
      "commandPalette": [
        {
          "command": "changestack.refresh",
          "when": "changestack.active"
        },
        {
          "command": "changestack.close",
          "when": "changestack.active"
        },
        {
          "command": "changestack.openLayer",
          "when": "false"
        },
        {
          "command": "changestack.openCohort",
          "when": "false"
        },
        {
          "command": "changestack.notScaffolding",
          "when": "false"
        },
        {
          "command": "changestack.nextHunk",
          "when": "changestack.active"
        },
        {
          "command": "changestack.prevHunk",
          "when": "changestack.active"
        },
        {
          "command": "changestack.nextLayer",
          "when": "changestack.active"
        },
        {
          "command": "changestack.prevLayer",
          "when": "changestack.active"
        },
        {
          "command": "changestack.toggleReviewed",
          "when": "changestack.active"
        },
        {
          "command": "changestack.markLayerReviewed",
          "when": "changestack.active"
        },
        {
          "command": "changestack.focusMode",
          "when": "changestack.active"
        },
        {
          "command": "changestack.markCohortReviewed",
          "when": "false"
        },
        {
          "command": "changestack.createComment",
          "when": "false"
        },
        {
          "command": "changestack.editComment",
          "when": "false"
        },
        {
          "command": "changestack.saveComment",
          "when": "false"
        },
        {
          "command": "changestack.cancelComment",
          "when": "false"
        },
        {
          "command": "changestack.deleteComment",
          "when": "false"
        },
        {
          "command": "changestack.repinComment",
          "when": "false"
        },
        {
          "command": "changestack.discardComment",
          "when": "false"
        },
        {
          "command": "changestack.export",
          "when": "changestack.active"
        },
        {
          "command": "changestack.walkthrough",
          "when": "changestack.active"
        },
        {
          "command": "changestack.recluster",
          "when": "changestack.active"
        },
        {
          "command": "changestack.openLayerFile",
          "when": "false"
        },
        {
          "command": "changestack.openLayerFiles",
          "when": "false"
        },
        {
          "command": "changestack.ask",
          "when": "changestack.active"
        },
        {
          "command": "changestack.askStep",
          "when": "changestack.active"
        },
        {
          "command": "changestack.submitReview",
          "when": "changestack.pr"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "changestack.createComment",
          "group": "inline@1",
          "when": "commentController == changestack"
        }
      ],
      "comments/comment/title": [
        {
          "command": "changestack.editComment",
          "group": "group@1",
          "when": "commentController == changestack && comment == changestack"
        },
        {
          "command": "changestack.deleteComment",
          "group": "group@2",
          "when": "commentController == changestack && comment == changestack"
        }
      ],
      "comments/comment/context": [
        {
          "command": "changestack.saveComment",
          "group": "inline@1",
          "when": "commentController == changestack"
        },
        {
          "command": "changestack.cancelComment",
          "group": "inline@2",
          "when": "commentController == changestack"
        }
      ]
    },
    "configuration": {
      "title": "Change Stack",
      "properties": {
        "changestack.ai.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Use a model to group, order and summarise the change. With this off the review still works, grouped by file."
        },
        "changestack.provider": {
          "type": "string",
          "default": "claude",
          "enum": [
            "claude",
            "vscode-lm"
          ],
          "markdownDescription": "Which provider receives the diff. **Choosing a provider is choosing where the code under review is sent.**",
          "enumDescriptions": [
            "The claude CLI you are already signed in to. Reads the repository while answering questions.",
            "Your editor's chat models (Copilot and anything else installed). No API key; cannot read the repository, so answers come from the diff alone."
          ]
        },
        "changestack.providers": {
          "type": "object",
          "default": {
            "claude": {
              "command": "claude",
              "models": {
                "fast": "haiku",
                "smart": "sonnet",
                "deep": "opus"
              }
            },
            "vscode-lm": {
              "models": {}
            }
          },
          "description": "Per-provider settings: executable and the model used for each tier."
        },
        "changestack.passes": {
          "type": "object",
          "default": {},
          "description": "Route individual passes to different providers, e.g. { \"summaries\": \"vscode-lm\", \"clustering\": \"claude\" }. Unset passes use changestack.provider.",
          "markdownDescription": "Route individual passes to different providers, e.g. `{ \"summaries\": \"vscode-lm\", \"clustering\": \"claude\" }`. Summaries are many small calls; clustering is the one call that decides the reading order. Unset passes use `changestack.provider`."
        },
        "changestack.scaffolding.mode": {
          "type": "string",
          "default": "collapse",
          "enum": [
            "collapse",
            "inline",
            "off"
          ],
          "enumDescriptions": [
            "Collect generated and boilerplate files into one trailing cohort, out of the reading order.",
            "Classify them, but leave them in the reading order.",
            "Do not classify at all."
          ],
          "description": "What to do with generated files, lockfiles and generator output."
        },
        "changestack.scaffolding.patterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra globs treated as scaffolding. Prefix with ! to force a path back into the review."
        },
        "changestack.walkthrough.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Open the walkthrough when the model finishes organising the change. It is the thing to read before any code."
        }
      }
    },
    "keybindings": [
      {
        "command": "changestack.nextHunk",
        "key": "alt+j",
        "when": "changestack.active"
      },
      {
        "command": "changestack.prevHunk",
        "key": "alt+k",
        "when": "changestack.active"
      },
      {
        "command": "changestack.nextLayer",
        "key": "alt+shift+j",
        "when": "changestack.active"
      },
      {
        "command": "changestack.prevLayer",
        "key": "alt+shift+k",
        "when": "changestack.active"
      },
      {
        "command": "changestack.toggleReviewed",
        "key": "alt+m",
        "when": "changestack.active"
      },
      {
        "command": "changestack.markLayerReviewed",
        "key": "alt+shift+m",
        "when": "changestack.active"
      },
      {
        "command": "changestack.focusMode",
        "key": "alt+z",
        "when": "changestack.active"
      },
      {
        "command": "changestack.walkthrough",
        "key": "alt+s",
        "when": "changestack.active"
      },
      {
        "command": "changestack.ask",
        "key": "alt+a",
        "when": "changestack.active"
      },
      {
        "command": "changestack.askStep",
        "key": "alt+shift+a",
        "when": "changestack.active"
      }
    ],
    "chatParticipants": [
      {
        "id": "changestack.ask",
        "name": "changestack",
        "fullName": "Change Stack",
        "description": "Ask about the change you are reading",
        "isSticky": true,
        "commands": [
          {
            "name": "step",
            "description": "Ask about the whole step, not just this hunk"
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "vscode:prepublish": "npm run check && node esbuild.mjs --production",
    "package": "npx --yes @vscode/vsce package",
    "eval": "vitest run --config vitest.eval.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
