{
  "name": "jury",
  "displayName": "Jury",
  "description": "Review a diff as an ordered stack of logical changes, not an alphabetical list of files. A model groups and orders the change; you judge the code.",
  "version": "0.0.1",
  "publisher": "pridont",
  "icon": "media/jury-tile-128.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pridont/jury.git"
  },
  "homepage": "https://github.com/pridont/jury#readme",
  "bugs": {
    "url": "https://github.com/pridont/jury/issues"
  },
  "private": true,
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "code review",
    "diff",
    "pull request",
    "claude",
    "ai"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:jury.stack"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jury",
          "title": "Jury",
          "icon": "media/jury.svg"
        }
      ]
    },
    "views": {
      "jury": [
        {
          "id": "jury.stack",
          "name": "Jury"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "jury.stack",
        "contents": "No review is open.\n[Review working tree](command:jury.review)\n[Review staged changes](command:jury.reviewStaged)\n[Review this branch](command:jury.reviewBase)\n[Review a pull request](command:jury.reviewPr)\n[Resume last review](command:jury.resume)\n",
        "when": "!jury.active"
      }
    ],
    "commands": [
      {
        "command": "jury.review",
        "title": "Review Working Tree",
        "category": "Jury",
        "icon": "$(git-compare)"
      },
      {
        "command": "jury.reviewStaged",
        "title": "Review Staged Changes",
        "category": "Jury"
      },
      {
        "command": "jury.reviewBase",
        "title": "Review This Branch…",
        "category": "Jury"
      },
      {
        "command": "jury.reviewPr",
        "title": "Review a Pull Request…",
        "category": "Jury"
      },
      {
        "command": "jury.submitReview",
        "title": "Submit Review to GitHub…",
        "category": "Jury",
        "icon": "$(github)"
      },
      {
        "command": "jury.refresh",
        "title": "Refresh Review",
        "category": "Jury",
        "icon": "$(refresh)"
      },
      {
        "command": "jury.close",
        "title": "Close Review",
        "category": "Jury",
        "icon": "$(close)"
      },
      {
        "command": "jury.resume",
        "title": "Resume Last Review",
        "category": "Jury"
      },
      {
        "command": "jury.list",
        "title": "Open a Saved Review…",
        "category": "Jury"
      },
      {
        "command": "jury.doctor",
        "title": "Doctor",
        "category": "Jury"
      },
      {
        "command": "jury.nextHunk",
        "title": "Next Hunk",
        "category": "Jury"
      },
      {
        "command": "jury.prevHunk",
        "title": "Previous Hunk",
        "category": "Jury"
      },
      {
        "command": "jury.nextLayer",
        "title": "Next Layer",
        "category": "Jury"
      },
      {
        "command": "jury.prevLayer",
        "title": "Previous Layer",
        "category": "Jury"
      },
      {
        "command": "jury.openLayer",
        "title": "Open Layer",
        "category": "Jury"
      },
      {
        "command": "jury.openCohort",
        "title": "Open All Files in This Cohort",
        "category": "Jury",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "jury.toggleReviewed",
        "title": "Toggle Reviewed on This Hunk",
        "category": "Jury"
      },
      {
        "command": "jury.markLayerReviewed",
        "title": "Mark Layer Reviewed and Advance",
        "category": "Jury"
      },
      {
        "command": "jury.markCohortReviewed",
        "title": "Mark Cohort Reviewed",
        "category": "Jury",
        "icon": "$(check-all)"
      },
      {
        "command": "jury.notScaffolding",
        "title": "Not Scaffolding",
        "category": "Jury",
        "icon": "$(eye)"
      },
      {
        "command": "jury.focusMode",
        "title": "Focus Mode",
        "category": "Jury"
      },
      {
        "command": "jury.createComment",
        "title": "Add Note",
        "category": "Jury"
      },
      {
        "command": "jury.editComment",
        "title": "Edit",
        "category": "Jury",
        "icon": "$(edit)"
      },
      {
        "command": "jury.saveComment",
        "title": "Save",
        "category": "Jury"
      },
      {
        "command": "jury.cancelComment",
        "title": "Cancel",
        "category": "Jury"
      },
      {
        "command": "jury.deleteComment",
        "title": "Delete",
        "category": "Jury",
        "icon": "$(trash)"
      },
      {
        "command": "jury.repinComment",
        "title": "Re-pin to a Hunk…",
        "category": "Jury",
        "icon": "$(pin)"
      },
      {
        "command": "jury.discardComment",
        "title": "Discard",
        "category": "Jury",
        "icon": "$(trash)"
      },
      {
        "command": "jury.export",
        "title": "Export Review as Markdown",
        "category": "Jury",
        "icon": "$(markdown)"
      },
      {
        "command": "jury.clearCache",
        "title": "Clear Model Answer Cache",
        "category": "Jury"
      },
      {
        "command": "jury.showLog",
        "title": "Show Log",
        "category": "Jury",
        "icon": "$(output)"
      },
      {
        "command": "jury.walkthrough",
        "title": "Show Walkthrough",
        "category": "Jury",
        "icon": "$(book)"
      },
      {
        "command": "jury.recluster",
        "title": "Reorganise the Stack",
        "category": "Jury",
        "icon": "$(sparkle)"
      },
      {
        "command": "jury.openLayerFile",
        "title": "Open File",
        "category": "Jury"
      },
      {
        "command": "jury.openLayerFiles",
        "title": "Open All Files in This Step",
        "category": "Jury",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "jury.ask",
        "title": "Ask About This Hunk",
        "category": "Jury",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "jury.askStep",
        "title": "Ask About This Step",
        "category": "Jury"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "jury.walkthrough",
          "when": "view == jury.stack && jury.active",
          "group": "navigation@0"
        },
        {
          "command": "jury.export",
          "when": "view == jury.stack && jury.active",
          "group": "navigation@0"
        },
        {
          "command": "jury.refresh",
          "when": "view == jury.stack && jury.active",
          "group": "navigation@1"
        },
        {
          "command": "jury.close",
          "when": "view == jury.stack && jury.active",
          "group": "navigation@2"
        },
        {
          "command": "jury.showLog",
          "when": "view == jury.stack",
          "group": "1_log@1"
        },
        {
          "command": "jury.recluster",
          "when": "view == jury.stack && jury.active",
          "group": "1_log@0"
        },
        {
          "command": "jury.submitReview",
          "when": "view == jury.stack && jury.pr",
          "group": "1_log@2"
        }
      ],
      "view/item/context": [
        {
          "command": "jury.openCohort",
          "when": "view == jury.stack && viewItem =~ /^cohort/",
          "group": "inline@1"
        },
        {
          "command": "jury.openCohort",
          "when": "view == jury.stack && viewItem =~ /^cohort/",
          "group": "navigation@1"
        },
        {
          "command": "jury.markCohortReviewed",
          "when": "view == jury.stack && viewItem =~ /^cohort/",
          "group": "navigation@2"
        },
        {
          "command": "jury.notScaffolding",
          "when": "view == jury.stack && viewItem == cohort-scaffolding",
          "group": "navigation@3"
        },
        {
          "command": "jury.notScaffolding",
          "when": "view == jury.stack && viewItem == layer",
          "group": "navigation@3"
        },
        {
          "command": "jury.openLayer",
          "when": "view == jury.stack && viewItem == layer",
          "group": "navigation@1"
        },
        {
          "command": "jury.repinComment",
          "when": "view == jury.stack && viewItem == orphan",
          "group": "inline@1"
        },
        {
          "command": "jury.discardComment",
          "when": "view == jury.stack && viewItem == orphan",
          "group": "inline@2"
        },
        {
          "command": "jury.openLayerFiles",
          "when": "view == jury.stack && viewItem == layer",
          "group": "inline@1"
        },
        {
          "command": "jury.openLayerFiles",
          "when": "view == jury.stack && viewItem == layer",
          "group": "navigation@0"
        }
      ],
      "commandPalette": [
        {
          "command": "jury.refresh",
          "when": "jury.active"
        },
        {
          "command": "jury.close",
          "when": "jury.active"
        },
        {
          "command": "jury.openLayer",
          "when": "false"
        },
        {
          "command": "jury.openCohort",
          "when": "false"
        },
        {
          "command": "jury.notScaffolding",
          "when": "false"
        },
        {
          "command": "jury.nextHunk",
          "when": "jury.active"
        },
        {
          "command": "jury.prevHunk",
          "when": "jury.active"
        },
        {
          "command": "jury.nextLayer",
          "when": "jury.active"
        },
        {
          "command": "jury.prevLayer",
          "when": "jury.active"
        },
        {
          "command": "jury.toggleReviewed",
          "when": "jury.active"
        },
        {
          "command": "jury.markLayerReviewed",
          "when": "jury.active"
        },
        {
          "command": "jury.focusMode",
          "when": "jury.active"
        },
        {
          "command": "jury.markCohortReviewed",
          "when": "false"
        },
        {
          "command": "jury.createComment",
          "when": "false"
        },
        {
          "command": "jury.editComment",
          "when": "false"
        },
        {
          "command": "jury.saveComment",
          "when": "false"
        },
        {
          "command": "jury.cancelComment",
          "when": "false"
        },
        {
          "command": "jury.deleteComment",
          "when": "false"
        },
        {
          "command": "jury.repinComment",
          "when": "false"
        },
        {
          "command": "jury.discardComment",
          "when": "false"
        },
        {
          "command": "jury.export",
          "when": "jury.active"
        },
        {
          "command": "jury.walkthrough",
          "when": "jury.active"
        },
        {
          "command": "jury.recluster",
          "when": "jury.active"
        },
        {
          "command": "jury.openLayerFile",
          "when": "false"
        },
        {
          "command": "jury.openLayerFiles",
          "when": "false"
        },
        {
          "command": "jury.ask",
          "when": "jury.active"
        },
        {
          "command": "jury.askStep",
          "when": "jury.active"
        },
        {
          "command": "jury.submitReview",
          "when": "jury.pr"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "jury.createComment",
          "group": "inline@1",
          "when": "commentController == jury"
        }
      ],
      "comments/comment/title": [
        {
          "command": "jury.editComment",
          "group": "group@1",
          "when": "commentController == jury && comment == jury"
        },
        {
          "command": "jury.deleteComment",
          "group": "group@2",
          "when": "commentController == jury && comment == jury"
        }
      ],
      "comments/comment/context": [
        {
          "command": "jury.saveComment",
          "group": "inline@1",
          "when": "commentController == jury"
        },
        {
          "command": "jury.cancelComment",
          "group": "inline@2",
          "when": "commentController == jury"
        }
      ]
    },
    "configuration": {
      "title": "Jury",
      "properties": {
        "jury.ai.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Use a model to group, order and summarise the change. With this off the review still works, grouped by file."
        },
        "jury.provider": {
          "type": "string",
          "default": "claude",
          "enum": [
            "claude",
            "vscode-lm"
          ],
          "markdownDescription": "Which provider receives the diff. **Choosing a provider is choosing where the code under review is sent.**",
          "enumDescriptions": [
            "The claude CLI you are already signed in to. Reads the repository while answering questions.",
            "Your editor's chat models (Copilot and anything else installed). No API key; cannot read the repository, so answers come from the diff alone."
          ]
        },
        "jury.providers": {
          "type": "object",
          "default": {
            "claude": {
              "command": "claude",
              "models": {
                "fast": "haiku",
                "smart": "sonnet",
                "deep": "opus"
              }
            },
            "vscode-lm": {
              "models": {}
            }
          },
          "description": "Per-provider settings: executable and the model used for each tier."
        },
        "jury.passes": {
          "type": "object",
          "default": {},
          "description": "Route individual passes to different providers, e.g. { \"summaries\": \"vscode-lm\", \"clustering\": \"claude\" }. Unset passes use jury.provider.",
          "markdownDescription": "Route individual passes to different providers, e.g. `{ \"summaries\": \"vscode-lm\", \"clustering\": \"claude\" }`. Summaries are many small calls; clustering is the one call that decides the reading order. Unset passes use `jury.provider`."
        },
        "jury.scaffolding.mode": {
          "type": "string",
          "default": "collapse",
          "enum": [
            "collapse",
            "inline",
            "off"
          ],
          "enumDescriptions": [
            "Collect generated and boilerplate files into one trailing cohort, out of the reading order.",
            "Classify them, but leave them in the reading order.",
            "Do not classify at all."
          ],
          "description": "What to do with generated files, lockfiles and generator output."
        },
        "jury.scaffolding.patterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra globs treated as scaffolding. Prefix with ! to force a path back into the review."
        },
        "jury.walkthrough.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Open the walkthrough when the model finishes organising the change. It is the thing to read before any code."
        },
        "jury.ai.summariseUpTo": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "markdownDescription": "Skip per-file summaries on a change touching more than this many files. Summaries are one model call each — on a 180-file pull request that is a real amount of money and several minutes — and the larger the change, the less of each summary survives into the digest that grouping actually reads. Grouping still runs. Set to `0` to never summarise."
        }
      }
    },
    "keybindings": [
      {
        "command": "jury.nextHunk",
        "key": "alt+j",
        "when": "jury.active"
      },
      {
        "command": "jury.prevHunk",
        "key": "alt+k",
        "when": "jury.active"
      },
      {
        "command": "jury.nextLayer",
        "key": "alt+shift+j",
        "when": "jury.active"
      },
      {
        "command": "jury.prevLayer",
        "key": "alt+shift+k",
        "when": "jury.active"
      },
      {
        "command": "jury.toggleReviewed",
        "key": "alt+m",
        "when": "jury.active"
      },
      {
        "command": "jury.markLayerReviewed",
        "key": "alt+shift+m",
        "when": "jury.active"
      },
      {
        "command": "jury.focusMode",
        "key": "alt+z",
        "when": "jury.active"
      },
      {
        "command": "jury.walkthrough",
        "key": "alt+s",
        "when": "jury.active"
      },
      {
        "command": "jury.ask",
        "key": "alt+a",
        "when": "jury.active"
      },
      {
        "command": "jury.askStep",
        "key": "alt+shift+a",
        "when": "jury.active"
      }
    ],
    "chatParticipants": [
      {
        "id": "jury.ask",
        "name": "jury",
        "fullName": "Jury",
        "description": "Ask about the change you are reading",
        "isSticky": true,
        "commands": [
          {
            "name": "step",
            "description": "Ask about the whole step, not just this hunk"
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "vite build --mode development",
    "watch": "vite build --watch --mode development",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "vscode:prepublish": "npm run check && vite build",
    "package": "npx --yes @vscode/vsce package --no-dependencies --out jury.vsix",
    "eval": "vitest run --config vitest.eval.config.mts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
